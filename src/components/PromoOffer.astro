---
import { siteConfig } from '../data/site';

interface Props {
  showOffer?: boolean;
}

const { showOffer = true } = Astro.props;
---

{
  showOffer && (
    <aside class="promo-offer" aria-label="Акция от Rush Detailing" data-promo-offer hidden>
      <button class="promo-offer__close" type="button" aria-label="Закрыть предложение" data-promo-offer-close>×</button>
      <img class="promo-offer__badge" src="/images/promo-discount.png" alt="" />
      <div class="promo-offer__copy">
        <p>Акция от Rush Detailing</p>
        <strong>Звоните сейчас и получите скидку</strong>
      </div>
      <a class="promo-offer__link" href={`tel:${siteConfig.contacts.phone}`} data-analytics="promo-offer-call">
        Позвонить
      </a>
    </aside>
  )
}

<dialog class="promo-modal" data-promo-modal aria-labelledby="promo-modal-title">
  <div class="promo-modal__panel">
    <button class="promo-modal__close" type="button" aria-label="Закрыть" data-promo-modal-close>×</button>
    <div class="promo-modal__head">
      <img class="promo-modal__badge" src="/images/promo-discount.png" alt="" />
      <div>
        <p class="eyebrow">Акция от Rush Detailing</p>
        <h2 id="promo-modal-title">Звоните сейчас и получите скидку</h2>
        <p>Звоните, уточняйте удобное время записи и закрепляйте скидку на выбранную услугу.</p>
      </div>
    </div>
    <a class="button button-primary promo-modal__call" href={`tel:${siteConfig.contacts.phone}`} data-analytics="promo-modal-call">
      Позвонить
    </a>
  </div>
</dialog>

---
const currentLeadHref = Astro.url.pathname === '/' ? '/#lead-form' : `${Astro.url.pathname}#lead-form`;
const landingFormPaths = ['/premium-okleyka/', '/khimchistka-salona/', '/polirovka-avto/'];
const opensLeadPopup = !landingFormPaths.includes(Astro.url.pathname);
---

<div class="mobile-cta-bar">
  <a href={currentLeadHref} data-analytics="cta-mobile" data-lead-popup-open={opensLeadPopup ? 'true' : undefined}>Оставить заявку</a>
</div>

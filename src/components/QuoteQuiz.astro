---
import { siteConfig } from '../data/site';

const endpoint = siteConfig.forms.endpoint;
const options = [
  ['Полировка кузова', '15 000 ₽'], ['Бронепленка', '30 000 ₽'], ['Химчистка салона', '10 000 ₽'], ['Детейлинг-мойка', '4 500 ₽'],
];
---

<section class="section" id="lead-form">
  <div class="container">
    <div class="quote-quiz surface-card">
      <div class="quote-quiz__intro"><p class="eyebrow">Быстрый расчет</p><h2>Подберём услуги и сориентируем по стоимости</h2><p>Ответьте на несколько вопросов — менеджер увидит задачу до звонка.</p></div>
      <form data-quote-quiz data-endpoint={endpoint}>
        <div class="quote-quiz__grid">
          <label>Тип автомобиля<select name="car"><option>Седан</option><option>Кроссовер</option><option>Внедорожник</option><option>Купе / спорткар</option><option>Мотоцикл</option></select></label>
          <label>Что нужно сделать<select name="service">{options.map(([label]) => <option value={label}>{label}</option>)}</select></label>
          <label>Ваше имя<input name="name" data-name-only placeholder="Алексей" required /></label>
          <label>Номер телефона<input name="contact" data-phone-only inputmode="numeric" pattern="[0-9]{10,15}" maxlength="15" placeholder="79250000000" required /></label>
          <label>Email (необязательно)<input type="email" name="email" data-email-only placeholder="client@mail.ru" /></label>
        </div>
        <button class="button button-primary" type="submit">Получить расчет</button>
        <p class="quote-quiz__status" data-quote-status aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-quote-quiz]').forEach((form) => {
    const status = form.querySelector('[data-quote-status]');
    form.querySelectorAll('[data-name-only]').forEach((input) => input.addEventListener('input', () => { input.value = input.value.replace(/[^\p{L}\s-]/gu, ''); }));
    form.querySelectorAll('[data-phone-only]').forEach((input) => input.addEventListener('input', () => { input.value = input.value.replace(/\D/g, '').slice(0,15); }));
    form.querySelectorAll('[data-email-only]').forEach((input) => input.addEventListener('input', () => { input.value = input.value.replace(/[^A-Za-zА-Яа-яЁё@._-]/g, ''); }));
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const contact = String(data.get('contact') || '').trim();
      const email = String(data.get('email') || '').trim();
      if (!/^[\p{L}\s-]+$/u.test(name) || !/^\d{10,15}$/.test(contact)) { status.textContent = 'Проверьте имя и номер телефона.'; return; }
      status.textContent = 'Отправляем заявку…';
      try {
        const response = await fetch(form.dataset.endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ name, contact, email, service:data.get('service'), carMake:data.get('car'), source:location.pathname, leadType:'site_quiz' }) });
        if (!response.ok) throw new Error('Request failed');
        status.textContent = 'Заявка отправлена. Мы скоро свяжемся с вами.';
        form.reset();
      } catch { status.textContent = 'Не удалось отправить заявку. Позвоните нам или попробуйте еще раз.'; }
    });
  });
</script>

<style>
  .quote-quiz { display:grid; grid-template-columns:.8fr 1.2fr; gap:34px; padding:40px; }
  .quote-quiz__intro h2 { margin:8px 0 14px; font-size:clamp(28px,3vw,45px); line-height:1.04; }
  .quote-quiz__intro p:last-child { color:var(--muted); line-height:1.6; }
  .quote-quiz form { display:grid; gap:18px; }
  .quote-quiz__grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .quote-quiz label { display:grid; gap:7px; color:var(--muted); font-size:13px; font-weight:800; }
  .quote-quiz input,.quote-quiz select { width:100%; min-height:52px; border:1px solid var(--line); border-radius:12px; background:#141619; color:var(--text); padding:0 14px; font:inherit; outline:none; }
  .quote-quiz input:focus,.quote-quiz select:focus { border-color:var(--accent); }
  .quote-quiz .button { justify-self:start; }
  .quote-quiz__status { min-height:20px; margin:0; color:var(--muted); font-size:13px; }
  @media (max-width:850px) { .quote-quiz { grid-template-columns:1fr; } }
  @media (max-width:560px) { .quote-quiz { padding:24px 18px; } .quote-quiz__grid { grid-template-columns:1fr; } .quote-quiz .button { width:100%; } }
</style>

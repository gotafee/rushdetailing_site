---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import CTASection from '../../components/CTASection.astro';
import PriceTables from '../../components/PriceTables.astro';
import LeadForm from '../../components/LeadForm.astro';
import { siteConfig } from '../../data/site';
---

<Layout
  title="Услуги детейлинга в Москве — полировка, пленка, химчистка, мото | Rush Detailing"
  description="Основные услуги детейлинга в Москве: полировка, бронепленка, керамика, химчистка салона, детейлинг-мойка, локальный уход, мотоциклы и подготовка автомобиля к продаже. Rush Detailing, Строгино."
  pagePath="/uslugi"
  image="/images/hero-uslugi.jpg"
  keywords={[
    ...siteConfig.seo.defaultKeywords,
    'услуги детейлинга москва',
    'детейлинг услуги москва',
    'полировка керамика пленка москва',
  ]}
  breadcrumbs={[
    { label: 'Главная', href: '/' },
    { label: 'Услуги', href: '/uslugi' },
  ]}
>
  <HeroSection
    eyebrow="Услуги"
    title="Услуги детейлинга в Москве — от регулярного ухода до защиты кузова, салона и мото"
    description="Здесь собраны основные направления Rush Detailing: полировка, бронепленка, защитные покрытия, химчистка салона, мойка, локальный уход, мотоциклы и подготовка автомобиля к продаже."
    image="/images/hero-uslugi.jpg"
    compact={true}
  />
  <ServiceGrid />
  <CTASection
    title="Нужно подобрать услугу под ваш автомобиль?"
    text="Оставьте заявку — подскажем, какие работы действительно подойдут под вашу задачу, и сориентируем по срокам и стоимости."
  />
  <PriceTables />
  <LeadForm compact={true} />
</Layout>

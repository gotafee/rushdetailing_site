---
const pageTitle = 'Rush Detailing Demo';
const leadEndpoint = import.meta.env.PUBLIC_DEMO_LEAD_ENDPOINT || '';
const chatEndpoint = import.meta.env.PUBLIC_DEMO_CHAT_ENDPOINT || 'https://rush-ai-chat-fix.bakeevkarim.workers.dev/chat';
const services = [
  { title: 'Полировка кузова', price: 15000, vehicles: ['Седан', 'Кроссовер'], checked: true },
  { title: 'Предпродажная подготовка', price: 18000, vehicles: ['Седан', 'Кроссовер'] },
  { title: 'Оклейка авто бронепленкой', price: 30000, vehicles: ['Седан', 'Кроссовер'] },
  { title: 'Химчистка салона', price: 10000, vehicles: ['Седан', 'Кроссовер'] },
  { title: 'Детейлинг мойка', price: 4500, vehicles: ['Седан', 'Кроссовер'] },
  { title: 'Мойка мотоциклов', price: 1500, vehicles: ['Мото'] },
  { title: 'Детейлинг мотоциклов', price: 25000, vehicles: ['Мото'], checked: true },
  { title: 'Полировка мотоциклов', price: 10000, vehicles: ['Мото'] },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800;900&family=Montserrat:wght@800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="container hero__grid">
          <div>
            <p class="eyebrow">Rush Detailing demo</p>
            <h1>Квиз-заявка, чат-бот и CRM в Google Sheets</h1>
            <p>
              Демо показывает, как клиент быстро выбирает услуги, оставляет контакты, а заявка
              сразу уходит в Google-таблицу менеджера.
            </p>
            <div class="hero__actions">
              <a class="button button-primary" href="#quiz">Открыть квиз</a>
              <button class="button button-secondary" type="button" data-open-chat>Спросить у бота</button>
            </div>
          </div>
          <aside class="hero-card">
            <span>Сценарий</span>
            <b>Сайт → квиз → Google Sheets → обработка заявки</b>
            <p>CRM-таблица не показывается на сайте. Она живет отдельно в Google Sheets.</p>
          </aside>
        </div>
      </section>

      <section class="section">
        <div class="container cards">
          <article>
            <span>01</span>
            <h2>Понятная заявка</h2>
            <p>Клиент выбирает тип авто, услуги и удобное время без длинной формы.</p>
          </article>
          <article>
            <span>02</span>
            <h2>Ответы без звонка</h2>
            <p>Чат-бот отвечает на частые вопросы и помогает перейти к записи.</p>
          </article>
          <article>
            <span>03</span>
            <h2>CRM в Google</h2>
            <p>После подключения Apps Script лиды попадают в таблицу новой строкой.</p>
          </article>
        </div>
      </section>

      <section class="section" id="quiz">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Квиз-заявка</p>
            <h2>Рассчитать услугу и записаться</h2>
          </div>

          <form class="quiz" data-quiz-form data-endpoint={leadEndpoint}>
            <div class="quiz__main">
              <fieldset>
                <legend>1. Тип автомобиля</legend>
                <div class="car-tabs">
                  <label>
                    <input type="radio" name="car" value="Седан" data-multiplier="1" checked />
                    <img src="/images/sedan.png" alt="" loading="lazy" />
                    <span>Седан</span>
                  </label>
                  <label>
                    <input type="radio" name="car" value="Кроссовер" data-multiplier="1" />
                    <img src="/images/crossover.png" alt="" loading="lazy" />
                    <span>Кроссовер</span>
                  </label>
                  <label>
                    <input type="radio" name="car" value="Мото" data-multiplier="1" />
                    <img src="/images/moto.png" alt="" loading="lazy" />
                    <span>Мото</span>
                  </label>
                </div>
              </fieldset>

              <fieldset>
                <legend>2. Выберите услуги</legend>
                <div class="service-list">
                  {services.map((service) => (
                    <label data-vehicles={service.vehicles.join('|')}>
                      <input
                        type="checkbox"
                        name="services"
                        value={service.title}
                        data-price={service.price}
                        checked={service.checked}
                      />
                      <span>{service.title}</span>
                      <b>{service.price.toLocaleString('ru-RU')} ₽</b>
                    </label>
                  ))}
                </div>
              </fieldset>

              <fieldset>
                <legend>3. Контакты и запись</legend>
                <div class="contact-grid">
                  <label>Имя<input type="text" name="name" placeholder="Алексей" data-name-only required /></label>
                  <label>Телефон<input type="tel" name="phone" placeholder="79250000000" inputmode="numeric" pattern="[0-9]{10,15}" maxlength="15" data-phone-only required /></label>
                  <label>Email<input type="email" name="email" placeholder="client@mail.ru" data-email-only required /></label>
                  <label>
                    Когда удобно
                    <select name="time">
                      <option>Сегодня</option>
                      <option>Завтра</option>
                      <option>На выходных</option>
                      <option>Нужен звонок</option>
                    </select>
                  </label>
                </div>
              </fieldset>
            </div>

            <aside class="quiz__summary">
              <div class="summary-head">
                <h3>Итого</h3>
              </div>
              <dl>
                <div><dt>Авто</dt><dd data-summary-car>Седан</dd></div>
                <div><dt>Услуги</dt><dd data-summary-services>1 услуга</dd></div>
                <div><dt>Время</dt><dd data-summary-time>Сегодня</dd></div>
              </dl>
              <div class="price-row">
                <span>Стоимость</span>
                <b data-summary-price>15 000 ₽</b>
              </div>
              <p>*Ориентировочно. Финальный расчет зависит от состояния авто.</p>
              <button class="button button-primary" type="submit">Записаться с этим расчетом</button>
              <small data-submit-status></small>
            </aside>
          </form>
        </div>
      </section>
    </main>

    <div class="chat-backdrop" data-close-chat></div>
    <button class="chat-fab" type="button" data-open-chat aria-label="Открыть чат">?</button>

    <section class="chat-widget" data-chat-widget aria-hidden="true">
      <div class="chat-widget__top">
        <div class="chat-topline">
          <button type="button" data-close-chat aria-label="Закрыть чат">×</button>
        </div>
        <p class="chat-kicker">Rush Detailing assistant</p>
        <h2>Поможем с выбором услуги</h2>
        <p>Задайте вопрос по цене, срокам или записи. Ответ появится прямо здесь.</p>
      </div>
      <div class="chat-widget__body">
        <div class="messages" data-chat-messages>
          <p class="message message-bot">Здравствуйте. Я могу подсказать цены, сроки, услуги и помочь перейти к записи.</p>
        </div>
        <div class="chat-actions">
          <form class="chat-form" data-chat-form data-endpoint={chatEndpoint}>
            <input type="text" name="question" placeholder="Напишите вопрос" autocomplete="off" />
            <button type="submit">Отправить</button>
          </form>
        </div>
      </div>
    </section>

    <script is:inline>
      const quizForm = document.querySelector('[data-quiz-form]');
      const statusNode = document.querySelector('[data-submit-status]');
      const carNode = document.querySelector('[data-summary-car]');
      const servicesNode = document.querySelector('[data-summary-services]');
      const timeNode = document.querySelector('[data-summary-time]');
      const priceNode = document.querySelector('[data-summary-price]');
      const chatWidget = document.querySelector('[data-chat-widget]');
      const openChatButtons = document.querySelectorAll('[data-open-chat]');
      const closeChatButtons = document.querySelectorAll('[data-close-chat]');
      const chatMessages = document.querySelector('[data-chat-messages]');
      const chatForm = document.querySelector('[data-chat-form]');
      const serviceLabels = Array.from(quizForm.querySelectorAll('.service-list label'));
      const namePattern = /^[\p{L}\s-]+$/u;
      const emailPattern = /^[A-Za-zА-Яа-яЁё._-]+@[A-Za-zА-Яа-яЁё-]+(?:\.[A-Za-zА-Яа-яЁё-]+)+$/;

      quizForm.querySelectorAll('[data-name-only]').forEach((input) => {
        input.addEventListener('input', () => {
          input.value = input.value.replace(/[^\p{L}\s-]/gu, '');
        });
      });
      quizForm.querySelectorAll('[data-phone-only]').forEach((input) => {
        input.addEventListener('input', () => {
          input.value = input.value.replace(/\D/g, '').slice(0, 15);
        });
      });
      quizForm.querySelectorAll('[data-email-only]').forEach((input) => {
        input.addEventListener('input', () => {
          input.value = input.value.replace(/[^A-Za-zА-Яа-яЁё@._-]/g, '');
        });
      });

      const formatPrice = (value) => new Intl.NumberFormat('ru-RU').format(value) + ' ₽';

      const syncServicesForVehicle = () => {
        const car = quizForm.querySelector('input[name="car"]:checked')?.value || '';
        let hasCheckedVisibleService = false;
        serviceLabels.forEach((label) => {
          const input = label.querySelector('input[name="services"]');
          const visible = (label.dataset.vehicles || '').split('|').includes(car);
          label.hidden = !visible;
          if (!visible) input.checked = false;
          if (visible && input.checked) hasCheckedVisibleService = true;
        });
        if (!hasCheckedVisibleService) {
          const firstVisibleInput = serviceLabels.find((label) => !label.hidden)?.querySelector('input[name="services"]');
          if (firstVisibleInput) firstVisibleInput.checked = true;
        }
      };

      const getQuizData = () => {
        const data = new FormData(quizForm);
        const carInput = quizForm.querySelector('input[name="car"]:checked');
        const serviceInputs = Array.from(quizForm.querySelectorAll('.service-list label:not([hidden]) input[name="services"]:checked'));
        const base = serviceInputs.reduce((sum, input) => sum + Number(input.dataset.price || 0), 0);
        return {
          car: data.get('car') || '',
          services: serviceInputs.map((input) => input.value),
          time: data.get('time') || '',
          name: String(data.get('name') || '').trim(),
          phone: String(data.get('phone') || '').trim(),
          email: String(data.get('email') || '').trim(),
          price: base,
        };
      };

      const renderSummary = () => {
        const lead = getQuizData();
        carNode.textContent = lead.car;
        servicesNode.textContent = lead.services.length === 1 ? '1 услуга' : `${lead.services.length} услуг`;
        timeNode.textContent = lead.time;
        priceNode.textContent = formatPrice(lead.price);
      };

      quizForm.addEventListener('change', (event) => {
        if (event.target?.name === 'car') syncServicesForVehicle();
        renderSummary();
      });
      quizForm.addEventListener('input', renderSummary);
      quizForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!quizForm.reportValidity()) return;

        const lead = getQuizData();
        if (!namePattern.test(lead.name)) {
          statusNode.textContent = 'Имя может содержать только буквы, пробел и дефис.';
          return;
        }
        if (!/^\d{10,15}$/.test(lead.phone)) {
          statusNode.textContent = 'Укажите номер только цифрами: от 10 до 15 знаков.';
          return;
        }
        if (!emailPattern.test(lead.email)) {
          statusNode.textContent = 'Введите корректный email без цифр.';
          return;
        }
        const payload = {
          name: lead.name,
          contact: lead.phone,
          email: lead.email,
          service: lead.services.join(', '),
          source: 'client-rd-quiz-crm-9x4k2m7p',
          leadType: 'demo_quiz',
          carMake: lead.car,
          carModel: lead.time,
          price: lead.price,
        };

        if (!quizForm.dataset.endpoint) {
          statusNode.textContent = 'Приём заявок временно настраивается.';
          return;
        }
        statusNode.textContent = 'Отправляем заявку...';
        try {
          const response = await fetch(quizForm.dataset.endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!response.ok) throw new Error('Request failed');
          window.location.href = '/spasibo/';
        } catch {
          statusNode.textContent = 'Не удалось отправить. Проверьте Google Sheets endpoint.';
        }
      });

      const openChat = () => {
        chatWidget.classList.add('is-open');
        document.body.classList.add('chat-is-open');
        document.documentElement.classList.add('chat-is-open');
        chatWidget.setAttribute('aria-hidden', 'false');
      };
      const closeChat = () => {
        chatWidget.classList.remove('is-open');
        document.body.classList.remove('chat-is-open');
        document.documentElement.classList.remove('chat-is-open');
        chatWidget.setAttribute('aria-hidden', 'true');
      };
      openChatButtons.forEach((button) => button.addEventListener('click', openChat));
      closeChatButtons.forEach((button) => button.addEventListener('click', closeChat));

      const chatHistory = [];
      const dialogId = window.localStorage.getItem('rushDemoDialogId') || crypto.randomUUID();
      window.localStorage.setItem('rushDemoDialogId', dialogId);

      const addMessage = (text, type) => {
        const node = document.createElement('p');
        node.className = `message message-${type}`;
        node.textContent = text;
        chatMessages.append(node);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      };

      const requestChatAnswer = async (question) => {
        const response = await fetch(chatForm.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: question,
            dialogId,
            siteId: 'rush-detailing',
            history: chatHistory.slice(-4),
          }),
        });
        if (!response.ok) throw new Error('Chat request failed');
        const data = await response.json();
        if (!data?.answer) throw new Error('Empty chat answer');
        return data.answer;
      };

      const reply = async (question) => {
        if (!question.trim()) return;
        addMessage(question, 'user');
        chatHistory.push({ role: 'user', content: question });
        addMessage('Печатаю ответ...', 'bot');
        const typingNode = chatMessages.lastElementChild;
        try {
          const answer = await requestChatAnswer(question);
          typingNode.textContent = answer;
          chatHistory.push({ role: 'assistant', content: answer });
        } catch (error) {
          typingNode.textContent = 'ИИ временно недоступен. Оставьте заявку — менеджер ответит лично.';
        }
        chatMessages.scrollTop = chatMessages.scrollHeight;
      };

      chatForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = chatForm.elements.question;
        reply(input.value);
        input.value = '';
      });

      syncServicesForVehicle();
      renderSummary();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #050505;
    --panel: #11130f;
    --line: rgba(255, 255, 255, 0.12);
    --muted: rgba(255, 255, 255, 0.68);
    --text: #ffffff;
    --accent: #d9ff00;
    --accent-2: #bfff00;
    --olive: #354400;
    --glow: 0 0 36px rgba(217, 255, 0, 0.28);
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 18% 8%, rgba(217, 255, 0, 0.12), transparent 28%),
      radial-gradient(circle at 84% 10%, rgba(99, 125, 0, 0.18), transparent 26%),
      #050505;
    color: var(--text);
    font-family: Manrope, Arial, sans-serif;
  }
  html.chat-is-open, body.chat-is-open { overflow: hidden; }
  a { color: inherit; text-decoration: none; }
  button, input, select { font: inherit; }
  .container { width: min(1220px, calc(100% - 32px)); margin: 0 auto; }
  .hero { min-height: 620px; display: flex; align-items: center; padding: 72px 0 44px; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr); gap: 28px; }
  .eyebrow { margin: 0 0 12px; color: var(--accent-2); font-size: 13px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2, h3 { margin: 0; font-family: Montserrat, Manrope, Arial, sans-serif; letter-spacing: 0; }
  h1 { max-width: 920px; font-size: clamp(44px, 6vw, 88px); line-height: .94; }
  .hero p, .cards p, .hero-card p { color: var(--muted); line-height: 1.65; }
  .hero p { max-width: 720px; margin: 22px 0 0; font-size: 18px; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 22px; border-radius: 10px; border: 1px solid var(--line); cursor: pointer; color: #fff; font-weight: 900; transition: transform .22s ease, border-color .22s ease, background .22s ease, box-shadow .22s ease; }
  .button:hover { transform: translateY(-1px); }
  .button-primary { border-color: rgba(217,255,0,.86); background: rgba(53,68,0,.92); box-shadow: var(--glow); }
  .button-primary:hover { background: rgba(72,92,0,.96); box-shadow: 0 0 44px rgba(217,255,0,.32); }
  .button-secondary { background: rgba(255,255,255,.04); }
  .hero-card, .cards article, .quiz, .chat-widget { border: 1px solid var(--line); background: rgba(17,19,15,.88); box-shadow: 0 28px 80px rgba(0,0,0,.38); backdrop-filter: blur(18px); }
  .hero-card { display: grid; align-content: end; min-height: 420px; padding: 28px; border-radius: 18px; }
  .hero-card span { width: fit-content; margin-bottom: 16px; padding: 8px 12px; border: 1px solid rgba(217,255,0,.5); color: var(--accent-2); font-size: 12px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .hero-card b { font-size: 30px; line-height: 1.08; }
  .section { padding: 56px 0; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cards article { min-height: 220px; padding: 24px; border-radius: 16px; }
  .cards span { display: block; margin-bottom: 24px; color: var(--accent-2); font-weight: 900; }
  .cards h2 { font-size: 24px; }
  .section-heading { margin-bottom: 22px; }
  .section-heading h2 { font-size: clamp(34px, 4vw, 58px); line-height: 1; }
  .quiz { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 6px; border-radius: 8px; overflow: hidden; animation: quizLift .45s ease both; }
  .quiz__main { padding: 30px 34px; }
  fieldset { margin: 0 0 28px; padding: 0; border: 0; }
  legend { margin-bottom: 16px; font-weight: 900; }
  .car-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); }
  .car-tabs label { display: grid; place-items: center; gap: 5px; min-height: 92px; border-right: 1px solid var(--line); cursor: pointer; color: var(--muted); font-size: 15px; font-weight: 900; transition: color .22s ease, background .22s ease, box-shadow .22s ease, transform .22s ease; }
  .car-tabs label:last-child { border-right: 0; }
  .car-tabs input { position: absolute; opacity: 0; }
  .car-tabs img { width: 54px; height: 32px; object-fit: contain; opacity: .72; filter: invert(1) brightness(1.4); transition: opacity .22s ease, transform .22s ease, filter .22s ease; }
  .car-tabs label:hover { background: rgba(255,255,255,.035); color: #fff; }
  .car-tabs label:hover img { opacity: 1; transform: translateY(-1px); }
  .car-tabs label:has(input:checked) { background: rgba(217,255,0,.12); box-shadow: inset 0 -2px 0 var(--accent); color: #fff; transform: translateY(-1px); }
  .car-tabs label:has(input:checked) img { opacity: 1; filter: invert(1) brightness(1.55) drop-shadow(0 0 12px rgba(217,255,0,.28)); }
  .service-list { display: grid; gap: 2px; }
  .service-list label { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; min-height: 52px; padding: 0 16px; background: rgba(255,255,255,.018); cursor: pointer; transition: transform .2s ease, background .2s ease, box-shadow .2s ease; }
  .service-list label:hover { background: rgba(255,255,255,.04); transform: translateX(2px); }
  .service-list label:has(input:checked) { background: rgba(217,255,0,.055); box-shadow: inset 2px 0 0 rgba(217,255,0,.72); }
  .service-list input { width: 18px; height: 18px; accent-color: var(--accent); }
  .service-list span { color: rgba(255,255,255,.84); font-size: 14px; font-weight: 800; }
  .service-list b { color: rgba(255,255,255,.7); font-size: 14px; }
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .contact-grid label { display: grid; gap: 8px; color: var(--muted); font-size: 13px; font-weight: 900; }
  .contact-grid input, .contact-grid select { min-height: 48px; border: 1px solid var(--line); border-radius: 8px; background: #0b0d09; color: #fff; padding: 0 12px; outline: none; transition: border-color .2s ease, box-shadow .2s ease, background .2s ease; }
  .contact-grid input:focus, .contact-grid select:focus { border-color: var(--accent); background: #0f120b; box-shadow: 0 0 0 3px rgba(217,255,0,.08); }
  .quiz__summary { display: flex; flex-direction: column; min-height: 100%; padding: 30px; border-left: 1px solid rgba(217,255,0,.52); background: rgba(7,8,6,.78); }
  .summary-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
  .summary-head h3 { font-size: 24px; }
  dl { display: grid; gap: 16px; margin: 24px 0; }
  dl div, .price-row { display: flex; justify-content: space-between; gap: 18px; }
  dt, .price-row span { color: var(--muted); font-weight: 900; }
  dd { margin: 0; text-align: right; font-weight: 900; }
  .price-row { align-items: end; padding: 24px 0; border-top: 1px solid var(--line); }
  .price-row b { font-size: 34px; }
  .quiz__summary p, .quiz__summary small { color: var(--muted); font-size: 12px; line-height: 1.5; }
  .quiz__summary .button { margin-top: auto; width: 100%; }
  .chat-backdrop { position: fixed; inset: 0; z-index: 22; background: rgba(0,0,0,.58); opacity: 0; pointer-events: none; backdrop-filter: blur(6px); transition: opacity .28s ease; }

---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ContactSection from '../components/ContactSection.astro';
import { siteConfig } from '../data/site';

const heroImage = {
  src: '/images/hero-polirovka-kuzova-avto.jpg',
  width: 1672,
  height: 941,
};

const beforeAfterImages = [
  { src: '/images/poli_1.jpg', width: 1672, height: 941, alt: 'Результат полировки кузова до и после, пример 1' },
  { src: '/images/poli_2.jpg', width: 1672, height: 941, alt: 'Результат полировки кузова до и после, пример 2' },
  { src: '/images/poli_3.jpg', width: 1672, height: 941, alt: 'Результат полировки кузова до и после, пример 3' },
  { src: '/images/poli_4.jpg', width: 1448, height: 1086, alt: 'Результат полировки кузова до и после, пример 4' },
];

const polishVideos = [
  {
    src: '/videos/rush_poli_ad_1.mp4',
    poster: '/images/video-preview-1.jpg',
    title: 'Осмотр кузова перед полировкой',
  },
  {
    src: '/videos/rush_poli_ad_2.mp4',
    poster: '/images/video-preview-2.jpg',
    title: 'Работа с лаком во время полировки',
  },
  {
    src: '/videos/rush_poli_ad_3.mp4',
    poster: '/images/video-preview-3.jpg',
    title: 'Финишная доводка кузова',
  },
  {
    src: '/videos/rush_poli_ad_4.mp4',
    poster: '/images/video-preview-4.jpg',
    title: 'Кузов после полировки',
  },
];

const pageFaq = [
  {
    question: 'Сколько стоит полировка кузова?',
    answer:
      'Простая полировка начинается от 10 000 ₽. Полноценная работа по кузову чаще попадает в диапазон 30-45 тысяч рублей. Точную цену называем после осмотра лака.',
  },
  {
    question: 'Можно ли рассчитать стоимость по фото?',
    answer:
      'Да, по фото можно дать предварительный ориентир. Перед работой все равно смотрим автомобиль в студии: часть царапин и следов от моек видна только под правильным светом.',
  },
  {
    question: 'Полировка уберет все мелкие царапины и паутинку?',
    answer:
      'Паутинка, мутность и неглубокие следы обычно уходят хорошо. Глубокие царапины могут стать менее заметными, но мы не будем снимать лишний лак только ради короткого блеска.',
  },
  {
    question: 'Нужно ли наносить защитное покрытие после полировки?',
    answer:
      'Не всегда. Если автомобиль часто ездит по городу и регулярно моется, защитное покрытие поможет дольше сохранить результат. Подходящий вариант подбираем после осмотра.',
  },
  {
    question: 'Сколько времени занимает работа?',
    answer:
      'Легкая полировка может занять несколько часов. Более глубокая работа по кузову обычно требует один или несколько дней, в зависимости от размера автомобиля и состояния лака.',
  },
];

const reasons = [
  ['Мутный лак', 'Кузов теряет глубину цвета, даже если автомобиль регулярно моют.'],
  ['Паутинка от моек', 'Мелкие круговые следы особенно заметны на солнце и под ярким светом.'],
  ['Следы эксплуатации', 'Дорожная грязь, реагенты и частые касания постепенно делают кузов визуально уставшим.'],
  ['Подготовка к продаже', 'Свежий кузов помогает автомобилю лучше выглядеть на фото и живом осмотре.'],
];

const formats = [
  ['Легкая полировка', 'Подходит перед продажей или когда кузову нужно быстро вернуть более свежий вид.'],
  ['Глубокая полировка', 'Берем больше времени на лак, если есть выраженная мутность, паутинка и следы эксплуатации.'],
  ['Полировка с защитой', 'После доводки кузова можно нанести керамику, воск или другой защитный состав.'],
  ['Оптика и стекла', 'Дополнительно можно отполировать фары и нанести антидождь на лобовое или все стекла.'],
];

const priceItems = [
  ['Абразивная полировка кузова', 'от 15 000 ₽'],
  ['Легкая полировка кузова', 'от 10 000 ₽'],
  ['Глубокая полировка кузова', 'от 30 000 ₽'],
  ['Полировка с защитным покрытием', 'от 37 000 ₽'],
  ['Полировка фар', 'от 2 000 ₽'],
];

const steps = [
  'Осматриваем кузов при свете',
  'Согласуем объем и стоимость',
  'Моем и готовим поверхность',
  'Полируем в несколько этапов',
  'Проверяем результат перед выдачей',
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Полировка кузова автомобиля',
  serviceType: 'Полировка авто',
  description:
    'Полировка кузова автомобиля в Rush Detailing в Москве. Осмотр, подготовка, аккуратная работа с лаком и расчет до начала работ.',
  areaServed: {
    '@type': 'City',
    name: 'Москва',
  },
  provider: {
    '@type': 'LocalBusiness',
    name: siteConfig.brand.name,
    telephone: siteConfig.contacts.phoneDisplay,
    url: siteConfig.siteUrl,
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'RUB',
    lowPrice: '30000',
    highPrice: '45000',
  },
};
---

<Layout
  title="Полировка авто в Москве | Rush Detailing"
  description="Полировка кузова автомобиля в Москве. Убираем мелкие царапины, паутинку и мутность лака. Осмотр перед началом, безопасный объем работ и расчет стоимости заранее."
  pagePath="/polirovka-avto"
  image={heroImage.src}
  showPromoOffer={false}
  keywords={[
    ...siteConfig.seo.defaultKeywords,
    'полировка авто москва',
    'полировка кузова авто москва',
    'полировка машины москва',
    'полировка кузова строгино',
  ]}
  breadcrumbs={[
    { label: 'Главная', href: '/' },
    { label: 'Полировка авто', href: '/polirovka-avto' },
  ]}
  faqSchema={pageFaq}
  extraSchemas={[serviceSchema]}
>
  <section class="polish-landing-hero">
    <div class="container">
      <div class="polish-landing-hero__card" style={`--polish-hero-image:url('${heroImage.src}')`}>
        <div class="polish-landing-hero__content">
          <p class="eyebrow">Полировка кузова</p>
          <h1 class="polish-title-desktop">
            Уберем любые царапины и паутику с гарантией
          </h1>
          <h1 class="polish-title-mobile">
            Уберем царапины и паутинку с гарантией
          </h1>
          <p class="hero-description polish-description-desktop">
            Осматриваем лакокрасочное покрытие, подбираем подходящий формат полировки и заранее называем стоимость. Работаем аккуратно и показываем результат перед выдачей.
          </p>
          <p class="hero-description polish-description-mobile">
            Оценим кузов, подберем полировку и заранее назовем стоимость работ.
          </p>
          <div class="polish-landing-hero__actions">
            <button type="button" class="button button-primary" data-analytics="polish-landing-primary" data-polish-highlight-form>Получить расчет</button>
            <a href={siteConfig.social.telegram} class="button button-secondary" target="_blank" rel="noreferrer" data-analytics="polish-landing-telegram">Отправить фото</a>
          </div>
          <ul class="polish-landing-badges">
            <li>От 10 000 ₽</li>
            <li>Осмотр перед началом</li>
            <li>Бережем толщину лака</li>
          </ul>
        </div>

        <form
          class="lead-form polish-landing-form"
          id="lead-form"
          data-lead-form
          data-endpoint={siteConfig.forms.endpoint}
          data-submit-mode={siteConfig.forms.submitMode}
          data-thank-you={siteConfig.forms.thankYouPath}
        >
          <div>
            <p class="eyebrow">Расчет полировки</p>
            <h2>Рассчитаем стоимость работ бесплатно</h2>
            <p>Оставьте контакт. Уточним автомобиль, попросим фото при необходимости и скажем, какой объем полировки имеет смысл.</p>
          </div>
          <input type="hidden" name="service" value="Рекламный лендинг: полировка авто" />
          <label>
            <span>Ваше имя</span>
            <input type="text" name="name" placeholder="Как к вам обращаться" pattern="[A-Za-zА-Яа-яЁё -]+" title="Используйте только буквы" required />
          </label>
          <label>
            <span>Телефон или Telegram</span>
            <input type="text" name="contact" placeholder="+7 или @username" required />
          </label>
          <button type="submit" class="button button-primary" data-analytics="polish-landing-submit">
            Получить расчет
          </button>
          <p class="form-note">{siteConfig.forms.consentText}</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-compact polish-section">
    <div class="container">
      <div class="surface-card polish-price-list-card">
        <div>
          <p class="eyebrow">Прайс-лист</p>
          <h2>Ориентиры по полировке</h2>
          <p>Финальную стоимость называем после осмотра. Цена зависит от состояния лака, размера автомобиля и глубины полировки.</p>
        </div>
        <ul class="polish-price-list">
          {priceItems.map(([label, value]) => (
            <li>
              <span>{label}</span>
              <strong>{value}</strong>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section polish-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">До / После</p>
        <h2>Показываем, как меняется кузов после полировки</h2>
        <p>Полировка не делает старый лак новым, но может заметно убрать мутность, освежить цвет и вернуть автомобилю более собранный вид.</p>
      </div>
      <div class="polish-before-after">
        {beforeAfterImages.map((image, index) => (
          <article class="surface-card polish-ba-card reveal">
            <button
              class="polish-ba-button"
              type="button"
              data-gallery-open
              data-gallery-index={index}
              aria-label={`Открыть фото ${index + 1} на весь экран`}
            >
              <img src={image.src} width={image.width} height={image.height} alt={image.alt} loading="lazy" />
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <dialog class="polish-gallery" data-gallery-dialog aria-label="Просмотр фото до и после">
    <button class="polish-gallery__close" type="button" data-gallery-close aria-label="Закрыть">×</button>
    <button class="polish-gallery__arrow polish-gallery__arrow-prev" type="button" data-gallery-prev aria-label="Предыдущее фото">‹</button>
    <figure class="polish-gallery__figure">
      <img data-gallery-image src={beforeAfterImages[0].src} alt={beforeAfterImages[0].alt} width={beforeAfterImages[0].width} height={beforeAfterImages[0].height} />
    </figure>
    <button class="polish-gallery__arrow polish-gallery__arrow-next" type="button" data-gallery-next aria-label="Следующее фото">›</button>
  </dialog>

  <section class="section section-compact polish-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Процесс</p>
        <h2>Как выглядит работа над автомобилем</h2>
        <p>Сначала смотрим лак под светом, потом согласуем объем. Так понятнее, где нужна глубокая работа, а где достаточно легкой доводки.</p>
      </div>
      <div class="polish-video-grid">
        {polishVideos.map((video, index) => (
          <article class="surface-card polish-video-card reveal">
            <div class="polish-video-frame">
              <video
                data-polish-video
                controls
                playsinline
                preload="metadata"
                poster={video.poster}
                width="1280"
                height="720"
                aria-label={video.title}
              >
                <source src={video.src} type="video/mp4" />
              </video>
              <button
                class="polish-video-play"
                type="button"
                data-polish-video-play
                aria-label={`Смотреть видео ${index + 1}: ${video.title}`}
              >
                <span></span>
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Хотите понять, сколько будет стоить полировка?"
    text="Оставьте заявку. Посмотрим состояние кузова, объясним подходящий объем работ и рассчитаем стоимость до начала."
    primaryLabel="Получить расчет"
    primaryHref="#lead-form"
  />

  <FAQAccordion items={pageFaq} />
  <ContactSection />

  <script is:inline define:vars={{ galleryImages: beforeAfterImages }}>
    const galleryDialog = document.querySelector('[data-gallery-dialog]');
    const galleryImage = document.querySelector('[data-gallery-image]');
    const galleryOpenButtons = document.querySelectorAll('[data-gallery-open]');
    const galleryClose = document.querySelector('[data-gallery-close]');
    const galleryPrev = document.querySelector('[data-gallery-prev]');
    const galleryNext = document.querySelector('[data-gallery-next]');
    const polishVideos = document.querySelectorAll('[data-polish-video]');
    const polishHighlightButtons = document.querySelectorAll('[data-polish-highlight-form]');
    const polishLeadForm = document.querySelector('#lead-form');
    let galleryIndex = 0;

    const updateGalleryImage = () => {
      const image = galleryImages[galleryIndex];
      if (!image || !galleryImage) return;
      galleryImage.src = image.src;
      galleryImage.alt = image.alt;
      galleryImage.width = image.width;
      galleryImage.height = image.height;
    };

    const openGallery = (index) => {
      if (!galleryDialog) return;
      galleryIndex = index;
      updateGalleryImage();

      if (typeof galleryDialog.showModal === 'function') {
        galleryDialog.showModal();
      } else {
        galleryDialog.setAttribute('open', '');
      }
    };

    const closeGallery = () => {
      if (!galleryDialog) return;
      galleryDialog.close();
    };

    const shiftGallery = (step) => {
      galleryIndex = (galleryIndex + step + galleryImages.length) % galleryImages.length;
      updateGalleryImage();
    };

    galleryOpenButtons.forEach((button) => {
      button.addEventListener('click', () => {
        openGallery(Number(button.getAttribute('data-gallery-index')) || 0);
      });
    });

    galleryClose?.addEventListener('click', closeGallery);
    galleryPrev?.addEventListener('click', () => shiftGallery(-1));
    galleryNext?.addEventListener('click', () => shiftGallery(1));

    galleryDialog?.addEventListener('click', (event) => {
      if (event.target === galleryDialog) {
        closeGallery();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!galleryDialog?.open) return;

      if (event.key === 'ArrowLeft') {
        shiftGallery(-1);
      }

      if (event.key === 'ArrowRight') {
        shiftGallery(1);
      }
    });

    polishHighlightButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!polishLeadForm) return;

        if (window.matchMedia('(max-width: 780px)').matches) {
          const estimateModal = document.querySelector('[data-estimate-contact-modal]');

          if (estimateModal) {
            if (typeof estimateModal.showModal === 'function') {
              estimateModal.showModal();
            } else {
              estimateModal.setAttribute('open', '');
            }
          }
          return;
        }

        polishLeadForm.classList.remove('is-highlighted');
        window.requestAnimationFrame(() => {
          polishLeadForm.classList.add('is-highlighted');
        });

        const firstInput = polishLeadForm.querySelector('input[name="name"]');
        firstInput?.focus({ preventScroll: true });

        window.setTimeout(() => {
          polishLeadForm.classList.remove('is-highlighted');
        }, 1800);
      });
    });

    polishVideos.forEach((video) => {
      const frame = video.closest('.polish-video-frame');
      const playButton = frame?.querySelector('[data-polish-video-play]');

      playButton?.addEventListener('click', () => {
        video.play();
      });

      video.addEventListener('play', () => {
        frame?.classList.add('is-playing');
        polishVideos.forEach((otherVideo) => {
          if (otherVideo !== video && !otherVideo.paused) {
            otherVideo.pause();
          }
        });
      });

      video.addEventListener('pause', () => {
        frame?.classList.remove('is-playing');
      });

      video.addEventListener('ended', () => {
        frame?.classList.remove('is-playing');
      });
    });

    window.addEventListener('DOMContentLoaded', () => {
      const estimateBadge = document.querySelector('[data-estimate-contact-modal] .promo-modal__badge');
      const estimateTitle = document.querySelector('#estimate-contact-modal-title');
      const estimateText = estimateTitle?.parentElement?.querySelector('p:last-child');
      const nudgeBadge = document.querySelector('[data-telegram-nudge-modal] .promo-modal__badge');
      const nudgeTitle = document.querySelector('#telegram-nudge-title');
      const nudgeText = nudgeTitle?.parentElement?.querySelector('p:last-child');
      const estimateEyebrow = document.querySelector('[data-estimate-contact-modal] .promo-modal__head .eyebrow');
      const estimateButton = document.querySelector('[data-estimate-contact-modal] .promo-modal__call');
      const nudgeEyebrow = document.querySelector('[data-telegram-nudge-modal] .eyebrow');
      const nudgeButton = document.querySelector('[data-analytics="telegram-nudge-call"]');

      if (estimateBadge) {
        estimateBadge.src = '/images/promo-discount.png';
        estimateBadge.alt = '';
      }

      if (estimateTitle) {
        estimateTitle.textContent = 'Звоните сейчас и получите скидку';
      }

      if (estimateText) {
        estimateText.textContent = 'Звоните администратору, уточняйте удобное время записи и закрепляйте скидку на выбранную услугу.';
      }

      if (estimateEyebrow) {
        estimateEyebrow.textContent = 'Акция от Rush Detailing';
      }

      if (estimateButton) {
        estimateButton.textContent = 'Позвонить';
      }

      if (nudgeBadge) {
        nudgeBadge.src = '/images/promo-discount.png';
        nudgeBadge.alt = '';
      }

      if (nudgeTitle) {
        nudgeTitle.textContent = 'Звоните сейчас и получите скидку';
      }

      if (nudgeText) {
        nudgeText.textContent = 'Звоните администратору, уточняйте удобное время записи и закрепляйте скидку на выбранную услугу.';
      }

      if (nudgeEyebrow) {
        nudgeEyebrow.textContent = 'Акция от Rush Detailing';
      }

      if (nudgeButton) {
        nudgeButton.textContent = 'Позвонить';
      }
    });
  </script>
</Layout>

<style>
  .polish-landing-hero {
    padding: 8px 0 clamp(26px, 4vw, 46px);
  }

  :global(body:has(.polish-landing-hero) .breadcrumbs) {
    padding-top: 12px;
  }

  :global(body:has(.polish-landing-hero) .cta-banner) {
    min-width: 0;
    overflow: hidden;
  }

  :global(body:has(.polish-landing-hero) .cta-actions) {
    flex-wrap: wrap;
    justify-content: flex-end;
    min-width: 0;
  }

  :global(body:has(.polish-landing-hero) .cta-actions .button) {
    min-width: 0;
  }

  :global(body:has(.polish-landing-hero) .mobile-cta-bar) {
    display: none;
  }

  .polish-section {
    padding-top: clamp(34px, 5vw, 64px);
    padding-bottom: clamp(34px, 5vw, 64px);
  }

  .polish-landing-hero__card {
    position: relative;
    display: grid;
    width: 100%;
    box-sizing: border-box;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 430px);
    align-items: stretch;
    gap: clamp(16px, 2vw, 28px);
    min-height: 0;
    height: auto;
    padding: clamp(16px, 1.45vw, 24px);
    overflow: hidden;
    border: 1px solid rgba(217, 255, 0, 0.42);
    border-radius: 36px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.54) 0%, rgba(0, 0, 0, 0.36) 45%, rgba(0, 0, 0, 0.72) 100%),
      var(--polish-hero-image) center/cover no-repeat;
    box-shadow: var(--shadow-lg);
  }

  .polish-landing-hero__content {
    display: grid;
    align-self: stretch;
    align-content: start;
    height: 100%;
    box-sizing: border-box;
    gap: 12px;
    min-width: 0;
    max-width: 820px;
  }

  .polish-landing-hero__content h1 {
    max-width: 820px;
    font-size: clamp(2.8rem, 3.66vw, 4.26rem);
    line-height: 0.96;
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .polish-landing-hero__content .polish-title-desktop {
    font-size: clamp(3.1rem, 4vw, 4.65rem);
  }

  .polish-landing-hero__content .hero-description {
    max-width: 720px;
    font-size: clamp(0.9rem, 0.95vw, 0.98rem);
    line-height: 1.65;
  }

  .polish-title-mobile,
  .polish-description-mobile {
    display: none !important;
  }

  .polish-landing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
    margin-bottom: 18px;
  }

  .polish-landing-hero__actions .button-secondary {
    color: #ffffff;
  }

  .polish-landing-badges {
    position: static;
    display: grid;

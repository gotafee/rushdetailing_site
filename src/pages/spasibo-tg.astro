---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site';
---

<Layout
  title="Ждите сообщения в Telegram - Rush Detailing"
  description="Спасибо за заявку в Rush Detailing. Мы напишем вам в Telegram для уточнения деталей по акции."
  pagePath="/spasibo-tg"
  noindex={true}
  breadcrumbs={[
    { label: 'Главная', href: '/' },
    { label: 'Спасибо', href: '/spasibo-tg' },
  ]}
>
  <section class="section">
    <div class="container">
      <div class="surface-card thank-you-card">
        <p class="eyebrow">Заявка отправлена</p>
        <h1>Ждите нашего сообщения в Telegram</h1>
        <p>Мы получили ваш username, зафиксируем скидку и напишем вам в Telegram для уточнения деталей по полировке.</p>
        <div class="hero-actions">
          <a href={siteConfig.social.telegram} class="button button-primary" target="_blank" rel="noreferrer">Открыть Telegram</a>
          <a href="/" class="button button-secondary">На главную</a>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    window.setTimeout(() => {
      window.location.replace('/');
    }, 10000);
  </script>
</Layout>

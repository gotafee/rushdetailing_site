---
import Layout from '../../layouts/Layout.astro';
const endpoint = import.meta.env.PUBLIC_DEMO_LEAD_ENDPOINT || '';
---
<Layout title="Демо AI-консультанта — Rush Detailing" description="Демонстрация будущего сценария консультации и записи." pagePath="/demo/ai-quiz/" noindex={true} showPromoOffer={false}>
  <section class="hero"><div class="container"><p>DEMO · БУДУЩИЙ СЦЕНАРИЙ</p><h1>Подберём уход<br />для вашего автомобиля</h1><span>AI-консультант отвечает на вопросы, а запись проходит в четыре коротких шага.</span></div></section>
  <section class="container board">
    <article class="card"><header><b><i></i>AI-консультант Rush</b><small>Демо-режим · локальные сценарные ответы</small></header><div id="messages" class="messages"><div class="msg bot">Здравствуйте! Помогу сориентироваться по услугам, срокам и подготовке автомобиля. Что хотите узнать?</div></div><div class="prompts"><button data-q="Сколько занимает полировка?">Сроки полировки</button><button data-q="Чем керамика отличается от плёнки?">Керамика или плёнка?</button><button data-q="Сколько стоит детейлинг?">Как узнать стоимость?</button></div><form id="chat"><input maxlength="300" aria-label="Вопрос консультанту" placeholder="Напишите вопрос…" /><button class="primary">Отправить</button></form><small>Без передачи данных. Подключение реальной модели: функция <code>answer()</code>.</small></article>
    <article id="quiz" class="card" data-endpoint={endpoint}><header><b>Запись в студию</b><span id="counter">1 / 4</span></header><div class="progress"><i id="bar"></i></div><form id="lead" novalidate>
      <section class="step active" data-step="1"><h2>Какая марка автомобиля?</h2><p>Это поможет подготовить консультацию.</p><input name="carMake" required maxlength="80" placeholder="Например, BMW" /><button class="primary next">Продолжить</button></section>
      <section class="step" data-step="2"><h2>Какая модель?</h2><p>Можно указать год выпуска через запятую.</p><input name="carModel" required maxlength="100" placeholder="Например, X5, 2022" /><div><button class="back">Назад</button><button class="primary next">Продолжить</button></div></section>
      <section class="step" data-step="3"><h2>Какая услуга интересует?</h2><p>Если сомневаетесь — выберите консультацию.</p><select name="service" required><option value="">Выберите услугу</option><option>Полировка кузова</option><option>Керамическое покрытие</option><option>Антигравийная плёнка</option><option>Химчистка салона</option><option>Комплексный уход</option><option>Нужна консультация</option></select><div><button class="back">Назад</button><button class="primary next">Продолжить</button></div></section>
      <section class="step" data-step="4"><h2>Куда прислать ответ?</h2><p>Контакты нужны только для связи по заявке.</p><input name="name" required maxlength="120" placeholder="Ваше имя" /><input name="contact" required maxlength="160" inputmode="tel" placeholder="Телефон" /><input name="email" required maxlength="160" type="email" placeholder="Email" /><label><input type="checkbox" required /> Согласен(-на) на обработку персональных данных</label><div><button class="back">Назад</button><button class="primary">Отправить заявку</button></div></section>
      <section class="step done" data-step="5"><strong>✓</strong><h2>Спасибо!</h2><p id="result">Демо-заявка заполнена. Для реальной отправки задайте серверный endpoint.</p><button id="restart">Заполнить ещё раз</button></section>
    </form></article>
  </section>
</Layout>
<script is:inline define:vars={{ endpoint }}>
  const answers=[['полиров','Полировка обычно занимает от одного дня: срок зависит от состояния кузова и объёма работ.'],['керамик','Керамика усиливает блеск и облегчает уход, а плёнка физически защищает зоны риска.'],['плёнк','Керамика усиливает блеск и облегчает уход, а плёнка физически защищает зоны риска.'],['стоим','Предварительно сориентируем по фото и задаче, а точную стоимость определим после осмотра.']];
  const answer=q=>answers.find(x=>q.toLowerCase().includes(x[0]))?.[1]||'В демо доступны базовые сценарии. Оставьте заявку — мастер уточнит задачу и предложит подходящий вариант.';
  const msgs=document.querySelector('#messages'),chat=document.querySelector('#chat'),input=chat.querySelector('input'); function say(t,c){const e=document.createElement('div');e.className='msg '+c;e.textContent=t;msgs.append(e);msgs.scrollTop=msgs.scrollHeight} function ask(q){if(!q.trim())return;say(q,'user');input.value='';setTimeout(()=>say(answer(q),'bot'),250)} chat.onsubmit=e=>{e.preventDefault();ask(input.value)};document.querySelectorAll('[data-q]').forEach(b=>b.onclick=()=>ask(b.dataset.q));
  const form=document.querySelector('#lead');let n=1;function show(x){n=x;document.querySelectorAll('.step').forEach(s=>s.classList.toggle('active',+s.dataset.step===n));document.querySelector('#counter').textContent=n<5?`${n} / 4`:'Готово';document.querySelector('#bar').style.width=`${Math.min(n,4)*25}%`}function valid(){const bad=[...form.querySelector(`[data-step="${n}"]`).querySelectorAll('input,select')].find(x=>!x.checkValidity());if(bad){bad.reportValidity();return false}return true}form.onclick=e=>{if(e.target.closest('.next')){e.preventDefault();if(valid())show(n+1)}if(e.target.closest('.back')){e.preventDefault();show(n-1)}};form.onsubmit=async e=>{e.preventDefault();if(!valid())return;const p=Object.fromEntries(new FormData(form));p.source='/demo/ai-quiz/';p.leadType='demo_quiz';const r=document.querySelector('#result');if(endpoint){try{const x=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});if(!x.ok)throw 0;r.textContent='Заявка отправлена. Мы свяжемся с вами в ближайшее время.'}catch{r.textContent='Не удалось отправить заявку. Попробуйте ещё раз или позвоните нам.'}}else r.textContent='Демо-заявка заполнена. Для реальной отправки задайте PUBLIC_DEMO_LEAD_ENDPOINT; Worker передаст её в Google Sheets при настроенном секрете.';show(5)};document.querySelector('#restart').onclick=()=>{form.reset();show(1)};
</script>
<style>
.hero{padding:75px 0 60px;background:radial-gradient(circle at 80% 15%,#9f3a15,transparent 30%),#090a0b;color:white}.hero p{color:#ff8052;font-size:.75rem;font-weight:800;letter-spacing:.16em}.hero h1{font:800 clamp(2.4rem,5vw,4.5rem)/.98 Montserrat,sans-serif;margin:14px 0}.hero span{color:#c6cbcd;font-size:1.1rem}.board{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;padding-block:54px}.card{background:#fff;border:1px solid #e3e5e5;border-radius:20px;padding:22px;box-shadow:0 8px 30px #0000000c}.card header{display:flex;justify-content:space-between;border-bottom:1px solid #eef0f0;padding-bottom:15px}.card header small,.card>small{display:block;color:#7d8588;font-size:.74rem;margin-top:5px}.card header i{display:inline-block;width:9px;height:9px;border-radius:50%;background:#28ae68;margin-right:8px}.messages{height:294px;overflow:auto;padding:20px 0}.msg{max-width:85%;margin:0 0 11px;padding:12px 14px;border-radius:14px;line-height:1.45;font-size:.9rem}.bot{background:#f0f2f2}.user{background:#181a1b;color:#fff;margin-left:auto}.prompts{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:12px}.prompts button{border:1px solid #ddd;background:white;border-radius:20px;padding:7px 10px;font-size:.73rem}.card form:not(#lead){display:flex;gap:8px}.card input,.card select{box-sizing:border-box;width:100%;padding:13px;border:1px solid #d8dcdd;border-radius:10px;font:inherit;margin-bottom:10px}.primary{background:#eb5b29!important;color:#fff!important;border:0!important;border-radius:9px;padding:12px 15px;font-weight:700;cursor:pointer}.progress{height:5px;background:#eee;margin:18px 0;border-radius:4px}.progress i{display:block;height:100%;width:25%;background:#eb5b29;border-radius:4px;transition:.2s}.step{display:none}.step.active{display:block}.step h2{font:800 1.4rem Montserrat,sans-serif;margin:0 0 8px}.step p{color:#737a7d;line-height:1.5}.step>div{display:flex;justify-content:space-between;gap:8px}.step button:not(.primary){border:0;border-radius:9px;padding:12px 15px;cursor:pointer}.step label{display:block;color:#666;font-size:.78rem;margin-bottom:14px}.step label input{width:auto;margin:0 6px 0 0}.done{text-align:center;padding:25px}.done strong{display:grid;place-items:center;background:#e3f6e9;color:#1c8a50;width:50px;height:50px;border-radius:50%;font-size:1.5rem;margin:auto}@media(max-width:800px){.board{grid-template-columns:1fr}.hero{padding:45px 0}.messages{height:240px}.card form:not(#lead){flex-direction:column}}
</style>

---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ContactSection from '../components/ContactSection.astro';
import { siteConfig } from '../data/site';

const heroImage = {
  src: '/images/hero-okleyka-kuzova-antigraviynoy-plenkoy.jpg',
  width: 1672,
  height: 941,
};

const galleryItems = [
  { src: '/images/okleika1.webp', alt: 'Оклейка кузова антигравийной пленкой в Rush Detailing' },
  { src: '/images/okleika2.webp', alt: 'Антигравийная пленка на кузове автомобиля' },
  { src: '/images/okleika3.webp', alt: 'Подготовка автомобиля к оклейке пленкой' },
  { src: '/images/okleika4.webp', alt: 'Детали оклейки антигравийной пленкой' },
];

const pageFaq = [
  {
    question: 'Сколько стоит оклейка антигравийной пленкой?',
    answer:
      'Расширенная оклейка обычно попадает в диапазон 220-290 тысяч рублей. Точная цена зависит от модели, площади пленки и подготовки кузова. По фото дадим ориентир, после осмотра зафиксируем смету.',
  },
  {
    question: 'Можно оклеить не весь автомобиль?',
    answer:
      'Да. Можно закрыть только переднюю часть, пороги, фары, зеркала, зоны под ручками или багажную зону. На осмотре покажем, где пленка даст пользу именно на вашем авто.',
  },
  {
    question: 'Зачем нужна антигравийная пленка?',
    answer:
      'Пленка берет на себя мелкие сколы от песка и камней, потертости на порогах, следы под ручками и царапины в багажной зоне. Для дорогого автомобиля это способ дольше сохранить родной лак.',
  },
  {
    question: 'Сколько времени занимает оклейка?',
    answer:
      'Обычно автомобиль остается в студии на несколько дней. Срок зависит от площади оклейки, состояния кузова и сложности элементов. Перед записью назовем срок по вашему автомобилю.',
  },
  {
    question: 'Нужна ли подготовка кузова перед пленкой?',
    answer:
      'Да. Перед оклейкой моем кузов, убираем загрязнения, проверяем лак и согласуем подготовку. Если поверхность не подготовить, пленка хуже садится и сильнее выдает края.',
  },
];

const reasons = [
  ['Передняя часть', 'Бампер, капот, фары, зеркала и передние крылья ловят больше всего песка и мелких камней. Их почти всегда смотрим первыми.'],
  ['Пороги и проемы', 'На этих местах лак быстро получает следы от обуви, реагентов и посадки пассажиров. Особенно на семейных и ежедневных авто.'],
  ['Зоны под ручками', 'Ногти, кольца и ключи быстро оставляют следы вокруг ручек. Пленка закрывает эту зону почти незаметно.'],
  ['Багажная зона', 'Сумки, коробки, коляски и чемоданы часто царапают край багажника. Небольшая зона, но польза от нее видна быстро.'],
];

const formats = [
  ['Передняя часть', 'Базовая защита от сколов: бампер, капот, фары, зеркала и передние крылья.'],
  ['Расширенный пакет', 'К передней части добавляем пороги, проемы, стойки, ручки и багажную зону. Подходит для частой городской езды.'],
  ['Полная оклейка', 'Закрываем весь кузов, когда важно сохранить родной лак и меньше думать о сколах на каждой поездке.'],
  ['Локальные зоны', 'Можно оклеить фары, ручки, пороги, край багажника или элементы, которые уже начали получать следы.'],
];

const priceItems = [
  ['Расширенная оклейка зон риска', 'от 220 000 ₽'],
  ['Полная оклейка кузова', 'от 290 000 ₽'],
  ['Оклейка передней части', 'от 150 000 ₽'],
  ['Локальная защита зон риска', 'от 60 000 ₽'],
  ['Фары, зеркала, зоны под ручками', 'от 25 000 ₽'],
];

const steps = [
  'Смотрим кузов по фото или на осмотре в студии',
  'Выбираем зоны защиты и фиксируем смету',
  'Моем кузов и готовим лак под пленку',
  'Оклеиваем элементы и подгоняем края',
  'Проверяем пленку перед выдачей автомобиля',
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Премиальная оклейка автомобиля антигравийной пленкой',
  serviceType: 'Оклейка авто антигравийной пленкой',
  description:
    'Оклейка автомобиля антигравийной пленкой в Rush Detailing в Москве. Подбор зон защиты, подготовка кузова и расчет стоимости до начала работ.',
  areaServed: {
    '@type': 'City',
    name: 'Москва',
  },
  provider: {
    '@type': 'LocalBusiness',
    name: siteConfig.brand.name,
    telephone: siteConfig.contacts.phoneDisplay,
    url: siteConfig.siteUrl,
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'RUB',
    lowPrice: '220000',
    highPrice: '290000',
  },
};
---

<Layout
  title="Премиальная оклейка авто пленкой в Москве | Rush Detailing"
  description="Премиальная оклейка автомобиля антигравийной пленкой в Москве. Защита кузова от сколов, расчет по зонам риска и смета после осмотра. Ориентир 220-290 тыс. ₽."
  pagePath="/premium-okleyka"
  image={heroImage.src}
  showPromoOffer={false}
  keywords={[
    ...siteConfig.seo.defaultKeywords,
    'премиальная оклейка авто москва',
    'оклейка авто антигравийной пленкой москва',
    'защита кузова пленкой москва',
    'оклейка дорогого авто пленкой',
  ]}
  breadcrumbs={[
    { label: 'Главная', href: '/' },
    { label: 'Премиальная оклейка', href: '/premium-okleyka' },
  ]}
  faqSchema={pageFaq}
  extraSchemas={[serviceSchema]}
>
  <section class="cleaning-landing-hero">
    <div class="container">
      <div class="cleaning-landing-hero__card" style={`--cleaning-hero-image:url('${heroImage.src}')`}>
        <div class="cleaning-landing-hero__content">
          <p class="eyebrow">Антигравийная пленка</p>
          <h1 class="cleaning-title-desktop">
            Защитим кузов от сколов, потертостей и следов эксплуатации
          </h1>
          <h1 class="cleaning-title-mobile">
            Защитим кузов от сколов, потертостей и следов эксплуатации
          </h1>
          <p class="hero-description cleaning-description-desktop">
            Подбираем зоны защиты, оцениваем состояние кузова и заранее называем стоимость. Аккуратно готовим поверхность, выполняем оклейку и проверяем результат перед выдачей.
          </p>
          <p class="hero-description cleaning-description-mobile">
            Подберем зоны защиты, назовем стоимость и объясним, где пленка действительно нужна.
          </p>
          <div class="cleaning-landing-hero__actions">
            <button type="button" class="button button-primary" data-analytics="premium-film-landing-primary" data-cleaning-highlight-form>Получить расчет</button>
            <a href={siteConfig.social.telegram} class="button button-secondary" target="_blank" rel="noreferrer" data-analytics="premium-film-landing-telegram">Отправить фото</a>
          </div>
          <ul class="cleaning-landing-badges">
            <li>Цена после осмотра</li>
            <li>Оценка по фото</li>
            <li>Подбор зон защиты</li>
          </ul>
        </div>

        <form
          class="lead-form cleaning-landing-form"
          id="lead-form"
          data-lead-form
          data-endpoint={siteConfig.forms.endpoint}
          data-submit-mode={siteConfig.forms.submitMode}
          data-thank-you={siteConfig.forms.thankYouPath}
        >
          <div>
            <p class="eyebrow">Расчет оклейки</p>
            <h2>Рассчитаем стоимость оклейки бесплатно</h2>
            <p>Оставьте контакт. Уточним автомобиль, посмотрим фото и предложим зоны защиты. После осмотра назовем точную стоимость.</p>
          </div>
          <input type="hidden" name="service" value="Рекламный лендинг: премиальная оклейка авто" />
          <label>
            <span>Ваше имя</span>
            <input type="text" name="name" placeholder="Как к вам обращаться" pattern="[A-Za-zА-Яа-яЁё -]+" title="Используйте только буквы" required />
          </label>
          <label>
            <span>Телефон или Telegram</span>
            <input type="text" name="contact" placeholder="+7 или @username" required />
          </label>
          <button type="submit" class="button button-primary" data-analytics="premium-film-landing-submit">
            Получить расчет
          </button>
          <p class="form-note">{siteConfig.forms.consentText}</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-compact cleaning-section">
    <div class="container">
      <div class="surface-card cleaning-price-list-card">
        <div>
          <p class="eyebrow">Прайс-лист</p>
          <h2>Ориентиры по оклейке</h2>
          <p>Цена зависит от модели, площади пленки и состояния кузова. Сначала выбираем зоны, где защита нужна, потом считаем стоимость до начала работ.</p>
        </div>
        <ul class="cleaning-price-list">
          {priceItems.map(([label, value]) => (
            <li>
              <span>{label}</span>
              <strong>{value}</strong>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section cleaning-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Примеры работ</p>
        <h2>Примеры оклейки антигравийной пленкой</h2>
      </div>
      <div class="cleaning-gallery-grid">
        {galleryItems.map((item, index) => (
          <article class="surface-card cleaning-gallery-card reveal">
            <button
              class="cleaning-gallery-media"
              type="button"
              data-gallery-open
              data-gallery-index={index}
              aria-label={`Открыть фото оклейки ${index + 1} на весь экран`}
            >
              <img src={item.src} alt={item.alt} loading="lazy" />
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <dialog class="cleaning-gallery-dialog" data-gallery-dialog aria-label="Просмотр фото оклейки">
    <button class="cleaning-gallery-dialog__close" type="button" data-gallery-close aria-label="Закрыть">×</button>
    <button class="cleaning-gallery-dialog__arrow cleaning-gallery-dialog__arrow-prev" type="button" data-gallery-prev aria-label="Предыдущее фото">‹</button>
    <figure class="cleaning-gallery-dialog__figure">
      <img data-gallery-image src={galleryItems[0].src} alt={galleryItems[0].alt} />
    </figure>
    <button class="cleaning-gallery-dialog__arrow cleaning-gallery-dialog__arrow-next" type="button" data-gallery-next aria-label="Следующее фото">›</button>
  </dialog>

  <section class="section cleaning-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Что защищаем</p>
        <h2>Закрываем зоны, где кузов получает повреждения первым</h2>
        <p>Смотрим, где кузов уже получает следы и как вы используете автомобиль. После этого предлагаем понятную карту оклейки без лишних зон.</p>
      </div>
      <div class="cleaning-feature-grid">
        {reasons.map(([title, text]) => (
          <article class="surface-card benefit-card reveal">
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-compact cleaning-section">
    <div class="container">
      <div class="surface-card cleaning-offer-strip">
        <div>
          <p class="eyebrow">Форматы</p>
          <h2>Подберем защиту под ваш автомобиль</h2>
          <p>Полная оклейка нужна не всегда. Иногда достаточно закрыть переднюю часть и места, которые чаще всего страдают в вашей эксплуатации.</p>
        </div>
        <div class="cleaning-format-grid">
          {formats.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-compact cleaning-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Процесс</p>
        <h2>Как проходит оклейка пленкой</h2>
        <p>До начала согласуем зоны и смету. Затем готовим кузов, оклеиваем элементы и проверяем края перед выдачей.</p>
      </div>
      <div class="cleaning-step-grid">
        {steps.map((step, index) => (
          <article class="surface-card timeline-card reveal">
            <span class="timeline-index">0{index + 1}</span>
            <h3>{step}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Хотите узнать стоимость оклейки?"
    text="Оставьте заявку или отправьте фото автомобиля. Посмотрим кузов, предложим зоны защиты и дадим ориентир по цене до записи."
    primaryLabel="Получить расчет"
    primaryHref="#lead-form"
  />

  <FAQAccordion items={pageFaq} />
  <ContactSection />

  <script is:inline define:vars={{ galleryImages: galleryItems }}>
    const galleryDialog = document.querySelector('[data-gallery-dialog]');
    const galleryImage = document.querySelector('[data-gallery-image]');
    const galleryOpenButtons = document.querySelectorAll('[data-gallery-open]');
    const galleryClose = document.querySelector('[data-gallery-close]');
    const galleryPrev = document.querySelector('[data-gallery-prev]');
    const galleryNext = document.querySelector('[data-gallery-next]');
    const cleaningHighlightButtons = document.querySelectorAll('[data-cleaning-highlight-form]');
    const cleaningLeadForm = document.querySelector('#lead-form');
    let galleryIndex = 0;

    const updateGalleryImage = () => {
      const image = galleryImages[galleryIndex];
      if (!image || !galleryImage) return;
      galleryImage.src = image.src;
      galleryImage.alt = image.alt;
    };

    const openGallery = (index) => {
      if (!galleryDialog) return;
      galleryIndex = Number(index) || 0;
      updateGalleryImage();

      if (typeof galleryDialog.showModal === 'function') {
        galleryDialog.showModal();
      } else {
        galleryDialog.setAttribute('open', '');
      }
    };

    const closeGallery = () => {
      if (!galleryDialog) return;
      if (typeof galleryDialog.close === 'function') {
        galleryDialog.close();
      } else {
        galleryDialog.removeAttribute('open');
      }
    };

    const shiftGallery = (direction) => {
      galleryIndex = (galleryIndex + direction + galleryImages.length) % galleryImages.length;
      updateGalleryImage();
    };

    galleryOpenButtons.forEach((button) => {
      button.addEventListener('click', () => openGallery(button.dataset.galleryIndex));
    });

    galleryClose?.addEventListener('click', closeGallery);
    galleryPrev?.addEventListener('click', () => shiftGallery(-1));
    galleryNext?.addEventListener('click', () => shiftGallery(1));

    galleryDialog?.addEventListener('click', (event) => {
      if (event.target === galleryDialog) {
        closeGallery();
      }
    });

    window.addEventListener('keydown', (event) => {
      if (!galleryDialog?.open) return;

      if (event.key === 'Escape') {
        closeGallery();
      }

      if (event.key === 'ArrowLeft') {
        shiftGallery(-1);
      }

      if (event.key === 'ArrowRight') {
        shiftGallery(1);
      }
    });

    cleaningHighlightButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!cleaningLeadForm) return;

        if (window.matchMedia('(max-width: 780px)').matches) {
          const estimateModal = document.querySelector('[data-estimate-contact-modal]');

          if (estimateModal) {
            if (typeof estimateModal.showModal === 'function') {
              estimateModal.showModal();
            } else {
              estimateModal.setAttribute('open', '');
            }
          }
          return;
        }

        cleaningLeadForm.classList.remove('is-highlighted');
        window.requestAnimationFrame(() => {
          cleaningLeadForm.classList.add('is-highlighted');
        });

        const firstInput = cleaningLeadForm.querySelector('input[name="name"]');
        firstInput?.focus({ preventScroll: true });

        window.setTimeout(() => {
          cleaningLeadForm.classList.remove('is-highlighted');
        }, 1800);
      });
    });

    window.addEventListener('DOMContentLoaded', () => {
      const estimateBadge = document.querySelector('[data-estimate-contact-modal] .promo-modal__badge');
      const estimateTitle = document.querySelector('#estimate-contact-modal-title');
      const estimateText = estimateTitle?.parentElement?.querySelector('p:last-child');
      const nudgeBadge = document.querySelector('[data-telegram-nudge-modal] .promo-modal__badge');
      const nudgeTitle = document.querySelector('#telegram-nudge-title');
      const nudgeText = nudgeTitle?.parentElement?.querySelector('p:last-child');
      const estimateEyebrow = document.querySelector('[data-estimate-contact-modal] .promo-modal__head .eyebrow');
      const estimateButton = document.querySelector('[data-estimate-contact-modal] button[type="submit"]');
      const nudgeEyebrow = document.querySelector('[data-telegram-nudge-modal] .eyebrow');
      const nudgeButton = document.querySelector('[data-estimate-contact-nudge-action]');

      if (estimateBadge) {
        estimateBadge.src = '/images/promo-discount.png';
        estimateBadge.alt = '';
      }

      if (estimateTitle) {
        estimateTitle.textContent = 'Рассчитаем стоимость оклейки бесплатно';
      }

      if (estimateText) {
        estimateText.textContent = 'Оставьте телефон или Telegram. Посмотрим фото автомобиля и подскажем, какие зоны стоит закрыть пленкой.';
      }

      if (estimateEyebrow) {
        estimateEyebrow.textContent = 'Рассчитать стоимость';
      }

      if (estimateButton) {
        estimateButton.textContent = 'Узнать стоимость';
      }

      if (nudgeBadge) {
        nudgeBadge.src = '/images/promo-discount.png';
        nudgeBadge.alt = '';
      }

      if (nudgeTitle) {
        nudgeTitle.textContent = 'Рассчитаем стоимость оклейки бесплатно';
      }

      if (nudgeText) {
        nudgeText.textContent = 'Напишите контакт. Посмотрим фото автомобиля и дадим предварительный ориентир по оклейке.';
      }

      if (nudgeEyebrow) {
        nudgeEyebrow.textContent = 'Рассчитать стоимость';
      }

      if (nudgeButton) {
        nudgeButton.textContent = 'Узнать стоимость';
      }
    });
  </script>
</Layout>

<style>
  .cleaning-landing-hero {
    padding: 8px 0 clamp(26px, 4vw, 46px);
  }

  :global(body:has(.cleaning-landing-hero) .breadcrumbs) {
    padding-top: 12px;
  }

  :global(body:has(.cleaning-landing-hero) .mobile-cta-bar) {
    display: none;
  }

  .cleaning-section {
    padding-top: clamp(34px, 5vw, 64px);
    padding-bottom: clamp(34px, 5vw, 64px);
  }

  .cleaning-landing-hero__card {
    position: relative;
    display: grid;
    width: 100%;
    box-sizing: border-box;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 430px);
    align-items: stretch;
    gap: clamp(16px, 2vw, 28px);
    min-height: 0;
    height: clamp(620px, calc(100svh - 150px), 690px);
    padding: clamp(16px, 1.45vw, 24px);
    overflow: hidden;
    border: 1px solid rgba(217, 255, 0, 0.42);
    border-radius: 36px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0.42) 45%, rgba(0, 0, 0, 0.76) 100%),
      var(--cleaning-hero-image) center/cover no-repeat;
    box-shadow: var(--shadow-lg);
  }

  .cleaning-landing-hero__content {
    display: grid;
    align-self: stretch;
    align-content: start;
    height: 100%;
    box-sizing: border-box;
    gap: 8px;
    min-width: 0;
    max-width: 840px;
  }

  .cleaning-landing-hero__content h1 {
    max-width: 820px;
    font-size: clamp(3rem, 4.25vw, 5rem);
    line-height: 0.96;
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .cleaning-landing-hero__content .hero-description {
    max-width: 720px;
    font-size: clamp(0.9rem, 0.95vw, 0.98rem);
    line-height: 1.65;
  }

  .cleaning-title-mobile,
  .cleaning-description-mobile {
    display: none !important;
  }

  .cleaning-landing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
    margin-bottom: 0;
  }

  .cleaning-landing-hero__actions .button-secondary {
    color: #ffffff;
  }

  .cleaning-landing-badges {
    position: static;
    display: grid;
    grid-template-columns: max-content max-content max-content;
    justify-content: start;
    gap: 8px;
    padding: 0;
    margin: 4px 0 0;
    list-style: none;
  }

  .cleaning-landing-badges li {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;

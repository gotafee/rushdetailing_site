---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ContactSection from '../components/ContactSection.astro';
import { siteConfig } from '../data/site';

const heroImage = {
  src: '/images/hero-khimchistka-salona.jpg',
  width: 1672,
  height: 941,
};

const galleryItems = [
  { src: '/images/him1.webp', alt: 'Химчистка салона автомобиля в Rush Detailing' },
  { src: '/images/him2.webp', alt: 'Чистка сидений и элементов салона' },
  { src: '/images/him3.webp', alt: 'Детали салона после химчистки' },
  { src: '/images/him4.webp', alt: 'Работа с загрязнениями в салоне автомобиля' },
];

const pageFaq = [
  {
    question: 'Сколько стоит химчистка салона?',
    answer:
      'Полная химчистка салона обычно стоит 18-25 тысяч рублей. Цена зависит от размера авто, материалов, пятен и запахов. По фото дадим ориентир, на осмотре подтвердим точную стоимость.',
  },
  {
    question: 'Можно ли оценить салон по фото?',
    answer:
      'Да. Пришлите сиденья, пол, потолок, дверные карты, багажник и самые заметные пятна. Мы скажем, какой объем чистки нужен и сколько это будет стоить примерно.',
  },
  {
    question: 'Химчистка убирает запахи?',
    answer:
      'Если запах держится в ткани, коврах или сиденьях, химчистка часто помогает. Если источник глубже, например в воздуховодах или старой пролитой жидкости, предложим отдельную обработку.',
  },
  {
    question: 'Салон будет влажным после работы?',
    answer:
      'Нет. После влажной чистки закладываем время на сушку и заранее говорим, когда автомобиль можно забрать. Сырой салон не выдаем.',
  },
  {
    question: 'Можно чистить кожу и ткань в одном салоне?',
    answer:
      'Можно. Для ткани, кожи, алькантары, пластика и потолка используем разные составы. Сначала смотрим материалы, потом выбираем безопасный способ чистки.',
  },
];

const reasons = [
  ['Сиденья и подлокотники', 'Убираем пятна, засаленность и следы ежедневной езды на местах, к которым чаще всего прикасаются.'],
  ['Пластик и дверные карты', 'Чистим ручки, кнопки, карманы, панели и стыки. Там быстро собирается пыль и липкая грязь.'],
  ['Ковры, пол и багажник', 'Прорабатываем ворс, направляющие сидений, зоны под ногами и места, куда обычная мойка почти не добирается.'],
  ['Потолок и запахи', 'С потолком работаем аккуратно. Если запах сидит глубже, заранее говорим, какая обработка может понадобиться.'],
];

const formats = [
  ['Локальная чистка', 'Подходит, если нужно убрать пятно, привести в порядок сиденье или освежить отдельную зону.'],
  ['Полная химчистка', 'Чистим сиденья, пол, ковры, пластик, дверные карты, багажник и трудные места.'],
  ['Перед продажей', 'Освежаем салон перед показом автомобиля, чтобы внутри было чисто и без резких запахов.'],
  ['Запахи и пятна', 'Сначала ищем источник проблемы. Потом предлагаем чистку или отдельную обработку воздуха, если она нужна.'],
];

const priceItems = [
  ['Химчистка салона', 'от 18 000 ₽'],
  ['Глубокая химчистка салона', 'от 22 000 ₽'],
  ['Предпродажная чистка салона', 'от 15 000 ₽'],
  ['Химчистка сидений', 'от 8 000 ₽'],
  ['Озонация салона', 'от 2 500 ₽'],
];

const steps = [
  'Смотрим фото или осматриваем салон в студии',
  'Фиксируем зоны, материалы и цену',
  'Убираем сухую грязь и готовим поверхности',
  'Чистим ткань, кожу, пластик, ковры и потолок',
  'Сушим салон и проверяем работу перед выдачей',
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Химчистка салона автомобиля',
  serviceType: 'Химчистка салона',
  description:
    'Химчистка салона автомобиля в Rush Detailing в Москве. Оценка по фото или осмотр в студии, чистка ткани, кожи, пластика, ковров и потолка.',
  areaServed: {
    '@type': 'City',
    name: 'Москва',
  },
  provider: {
    '@type': 'LocalBusiness',
    name: siteConfig.brand.name,
    telephone: siteConfig.contacts.phoneDisplay,
    url: siteConfig.siteUrl,
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'RUB',
    lowPrice: '18000',
    highPrice: '25000',
  },
};
---

<Layout
  title="Химчистка салона авто в Москве | Rush Detailing"
  description="Химчистка салона автомобиля в Москве. Чистим ткань, кожу, пластик, ковры, потолок и запахи. Оценка по фото, ориентир 18-25 тыс. ₽."
  pagePath="/khimchistka-salona"
  image={heroImage.src}
  showPromoOffer={false}
  keywords={[
    ...siteConfig.seo.defaultKeywords,
    'химчистка салона авто москва',
    'глубокая химчистка салона москва',
    'химчистка сидений авто москва',
    'химчистка салона строгино',
  ]}
  breadcrumbs={[
    { label: 'Главная', href: '/' },
    { label: 'Химчистка салона', href: '/khimchistka-salona' },
  ]}
  faqSchema={pageFaq}
  extraSchemas={[serviceSchema]}
>
  <section class="cleaning-landing-hero">
    <div class="container">
      <div class="cleaning-landing-hero__card" style={`--cleaning-hero-image:url('${heroImage.src}')`}>
        <div class="cleaning-landing-hero__content">
          <p class="eyebrow">Химчистка салона</p>
          <h1 class="cleaning-title-desktop">
            Освежим салон, уберем пятна, запахи и грязь из авто
          </h1>
          <h1 class="cleaning-title-mobile">
            Освежим салон, уберем пятна, запахи и грязь из авто
          </h1>
          <p class="hero-description cleaning-description-desktop">
            Чистим ткань, кожу, пластик, ковры и потолок. Оцениваем состояние салона, подбираем безопасные составы и заранее называем стоимость.
          </p>
          <p class="hero-description cleaning-description-mobile">
            Чистим ткань, кожу, пластик, ковры и потолок. Оцениваем салон и заранее называем стоимость.
          </p>
          <div class="cleaning-landing-hero__actions">
            <button type="button" class="button button-primary" data-analytics="cleaning-landing-primary" data-cleaning-highlight-form>Получить расчет</button>
            <a href={siteConfig.social.telegram} class="button button-secondary" target="_blank" rel="noreferrer" data-analytics="cleaning-landing-telegram">Отправить фото</a>
          </div>
          <ul class="cleaning-landing-badges">
            <li>От 18 000 ₽</li>
            <li>Оценка по фото</li>
            <li>Без скрытых доплат</li>
          </ul>
        </div>

        <form
          class="lead-form cleaning-landing-form"
          id="lead-form"
          data-lead-form
          data-endpoint={siteConfig.forms.endpoint}
          data-submit-mode={siteConfig.forms.submitMode}
          data-thank-you={siteConfig.forms.thankYouPath}
        >
          <div>
            <p class="eyebrow">Расчет химчистки</p>
            <h2>Рассчитаем стоимость работ бесплатно</h2>
            <p>Оставьте контакт. Уточним автомобиль, материалы салона и загрязнения. По фото дадим предварительную цену.</p>
          </div>
          <input type="hidden" name="service" value="Рекламный лендинг: химчистка салона" />
          <label>
            <span>Ваше имя</span>
            <input type="text" name="name" placeholder="Как к вам обращаться" pattern="[A-Za-zА-Яа-яЁё -]+" title="Используйте только буквы" required />
          </label>
          <label>
            <span>Телефон или Telegram</span>
            <input type="text" name="contact" placeholder="+7 или @username" required />
          </label>
          <button type="submit" class="button button-primary" data-analytics="cleaning-landing-submit">
            Получить расчет
          </button>
          <p class="form-note">{siteConfig.forms.consentText}</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-compact cleaning-section">
    <div class="container">
      <div class="surface-card cleaning-price-list-card">
        <div>
          <p class="eyebrow">Прайс-лист</p>
          <h2>Ориентиры по химчистке</h2>
          <p>Цена зависит от размера автомобиля, материалов и состояния салона. Стоимость называем до начала работ, без доплат на выдаче.</p>
        </div>
        <ul class="cleaning-price-list">
          {priceItems.map(([label, value]) => (
            <li>
              <span>{label}</span>
              <strong>{value}</strong>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section cleaning-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Примеры работ</p>
        <h2>Примеры химчистки салона</h2>
      </div>
      <div class="cleaning-gallery-grid">
        {galleryItems.map((item) => (
          <article class="surface-card cleaning-gallery-card reveal">
            <div class="cleaning-gallery-media">
              <img src={item.src} alt={item.alt} loading="lazy" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section cleaning-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Что чистим</p>
        <h2>Чистим не только сиденья</h2>
        <p>Грязь копится в стыках, коврах, карманах дверей, под сиденьями и на потолке. Поэтому сначала смотрим салон целиком, потом считаем работу.</p>
      </div>
      <div class="cleaning-feature-grid">
        {reasons.map(([title, text]) => (
          <article class="surface-card benefit-card reveal">
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-compact cleaning-section">
    <div class="container">
      <div class="surface-card cleaning-offer-strip">
        <div>
          <p class="eyebrow">Форматы</p>
          <h2>Подберем формат под вашу задачу</h2>
          <p>Можно почистить весь салон, подготовить авто к продаже или убрать отдельную проблему. Лишние услуги не добавляем.</p>
        </div>
        <div class="cleaning-format-grid">
          {formats.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-compact cleaning-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Процесс</p>
        <h2>Как проходит химчистка салона</h2>
        <p>До начала согласуем зоны, материалы и цену. После чистки сушим салон и проверяем, чтобы не осталось сырости и разводов.</p>
      </div>
      <div class="cleaning-step-grid">
        {steps.map((step, index) => (
          <article class="surface-card timeline-card reveal">
            <span class="timeline-index">0{index + 1}</span>
            <h3>{step}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Хотите узнать стоимость химчистки?"
    text="Оставьте заявку или отправьте фото салона. Посмотрим загрязнения, назовем срок и предварительную цену."
    primaryLabel="Получить расчет"
    primaryHref="#lead-form"
  />

  <FAQAccordion items={pageFaq} />
  <ContactSection />

  <script is:inline>
    const cleaningHighlightButtons = document.querySelectorAll('[data-cleaning-highlight-form]');
    const cleaningLeadForm = document.querySelector('#lead-form');

    cleaningHighlightButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!cleaningLeadForm) return;

        if (window.matchMedia('(max-width: 780px)').matches) {
          const estimateModal = document.querySelector('[data-estimate-contact-modal]');

          if (estimateModal) {
            if (typeof estimateModal.showModal === 'function') {
              estimateModal.showModal();
            } else {
              estimateModal.setAttribute('open', '');
            }
          }
          return;
        }

        cleaningLeadForm.classList.remove('is-highlighted');
        window.requestAnimationFrame(() => {
          cleaningLeadForm.classList.add('is-highlighted');
        });

        const firstInput = cleaningLeadForm.querySelector('input[name="name"]');
        firstInput?.focus({ preventScroll: true });

        window.setTimeout(() => {
          cleaningLeadForm.classList.remove('is-highlighted');
        }, 1800);
      });
    });

    window.addEventListener('DOMContentLoaded', () => {
      const estimateBadge = document.querySelector('[data-estimate-contact-modal] .promo-modal__badge');
      const estimateTitle = document.querySelector('#estimate-contact-modal-title');
      const estimateText = estimateTitle?.parentElement?.querySelector('p:last-child');
      const nudgeBadge = document.querySelector('[data-telegram-nudge-modal] .promo-modal__badge');
      const nudgeTitle = document.querySelector('#telegram-nudge-title');
      const nudgeText = nudgeTitle?.parentElement?.querySelector('p:last-child');
      const estimateEyebrow = document.querySelector('[data-estimate-contact-modal] .promo-modal__head .eyebrow');
      const estimateButton = document.querySelector('[data-estimate-contact-modal] button[type="submit"]');
      const nudgeEyebrow = document.querySelector('[data-telegram-nudge-modal] .eyebrow');
      const nudgeButton = document.querySelector('[data-estimate-contact-nudge-action]');

      if (estimateBadge) {
        estimateBadge.src = '/images/promo-discount.png';
        estimateBadge.alt = '';
      }

      if (estimateTitle) {
        estimateTitle.textContent = 'Получите диагностику и стоимость услуг';
      }

      if (estimateText) {
        estimateText.textContent = 'Оставьте контакт и отправьте фото. Посмотрим состояние авто и подскажем предварительный объем работ.';
      }

      if (estimateEyebrow) {
        estimateEyebrow.textContent = 'Оценка по фото';
      }

      if (estimateButton) {
        estimateButton.textContent = 'Узнать стоимость';
      }

      if (nudgeBadge) {
        nudgeBadge.src = '/images/promo-discount.png';
        nudgeBadge.alt = '';
      }

      if (nudgeTitle) {
        nudgeTitle.textContent = 'Получите диагностику и стоимость услуг';
      }

      if (nudgeText) {
        nudgeText.textContent = 'Оставьте контакт. Посмотрим фото и дадим предварительный ориентир.';
      }

      if (nudgeEyebrow) {
        nudgeEyebrow.textContent = 'Оценка по фото';
      }

      if (nudgeButton) {
        nudgeButton.textContent = 'Узнать стоимость';
      }
    });
  </script>
</Layout>

<style>
  .cleaning-landing-hero {
    padding: 8px 0 clamp(26px, 4vw, 46px);
  }

  :global(body:has(.cleaning-landing-hero) .breadcrumbs) {
    padding-top: 12px;
  }

  :global(body:has(.cleaning-landing-hero) .mobile-cta-bar) {
    display: none;
  }

  .cleaning-section {
    padding-top: clamp(34px, 5vw, 64px);
    padding-bottom: clamp(34px, 5vw, 64px);
  }

  .cleaning-landing-hero__card {
    position: relative;
    display: grid;
    width: 100%;
    box-sizing: border-box;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 430px);
    align-items: stretch;
    gap: clamp(16px, 2vw, 28px);
    min-height: 0;
    height: clamp(565px, calc(100svh - 200px), 620px);
    padding: clamp(16px, 1.45vw, 24px);
    overflow: hidden;
    border: 1px solid rgba(217, 255, 0, 0.42);
    border-radius: 36px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0.42) 45%, rgba(0, 0, 0, 0.76) 100%),
      var(--cleaning-hero-image) center/cover no-repeat;
    box-shadow: var(--shadow-lg);
  }

  .cleaning-landing-hero__content {
    display: grid;
    align-self: stretch;
    align-content: start;
    height: 100%;
    box-sizing: border-box;
    gap: 8px;
    min-width: 0;
    max-width: 840px;
  }

  .cleaning-landing-hero__content h1 {
    max-width: 820px;
    font-size: clamp(3rem, 4.25vw, 5rem);
    line-height: 0.96;
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .cleaning-landing-hero__content .hero-description {
    max-width: 720px;
    font-size: clamp(0.9rem, 0.95vw, 0.98rem);
    line-height: 1.65;
  }

  .cleaning-title-mobile,
  .cleaning-description-mobile {
    display: none !important;
  }

  .cleaning-landing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
    margin-bottom: 0;
  }

  .cleaning-landing-hero__actions .button-secondary {
    color: #ffffff;
  }

  .cleaning-landing-badges {
    position: static;
    display: grid;
    grid-template-columns: max-content max-content max-content;
    justify-content: start;
    gap: 8px;
    padding: 0;
    margin: 4px 0 0;
    list-style: none;
  }

  .cleaning-landing-badges li {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border: 1px solid rgba(217, 255, 0, 0.26);
    border-radius: 16px;
    color: var(--text);
    font-weight: 800;
    text-align: center;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.06);
  }

  .cleaning-landing-form {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-width: 430px;
    padding: clamp(18px, 1.55vw, 24px);
    gap: 10px;
    border: 1px solid rgba(217, 255, 0, 0.48);
    border-radius: 24px;
    background:
      linear-gradient(135deg, rgba(217, 255, 0, 0.14), rgba(217, 255, 0, 0.02) 42%),
      rgba(9, 10, 12, 0.94);
    box-shadow: var(--glow);
    backdrop-filter: blur(16px);
  }

  .cleaning-landing-form h2 {
    font-size: clamp(1.48rem, 1.82vw, 1.86rem);
    line-height: 1.02;
  }

  .cleaning-landing-form p:not(.eyebrow):not(.form-note) {
    font-size: clamp(0.94rem, 0.98vw, 1.02rem);
    line-height: 1.55;
  }

  .cleaning-landing-form label {
    gap: 8px;
  }

  .cleaning-landing-form input {
    min-width: 0;
    min-height: 50px;
  }

  .cleaning-landing-form .button {
    min-height: 52px;
  }

  .cleaning-landing-form .form-note {
    font-size: 0.72rem;
    line-height: 1.28;
  }

  .cleaning-landing-form.is-highlighted {
    animation: cleaningFormPulse 1.8s ease;
  }

  @keyframes cleaningFormPulse {
    0%,
    100% {
      border-color: rgba(217, 255, 0, 0.48);
      box-shadow: var(--glow);
      transform: translateY(0);
    }

    28% {
      border-color: rgba(217, 255, 0, 0.95);
      box-shadow:
        0 0 0 3px rgba(217, 255, 0, 0.16),
        0 0 42px rgba(217, 255, 0, 0.42);
      transform: translateY(-2px);
    }
  }

  .cleaning-price-list-card,
  .cleaning-offer-strip {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(420px, 1.22fr);
    gap: clamp(24px, 4vw, 44px);
    align-items: start;
    padding: clamp(24px, 4vw, 38px);
  }

  .cleaning-price-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cleaning-price-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    gap: 18px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .cleaning-price-list li:first-child {
    padding-top: 0;
  }

  .cleaning-price-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .cleaning-price-list span,
  .cleaning-price-list strong {
    color: var(--text);
    font-weight: 900;
  }

  .cleaning-price-list strong {
    white-space: nowrap;
  }

  .cleaning-gallery-grid,
  .cleaning-feature-grid,
  .cleaning-step-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 22px);
  }

  .cleaning-step-grid {

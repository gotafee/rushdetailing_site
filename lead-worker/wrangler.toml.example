name = "rushdetailing-leads"
main = "worker.js"
compatibility_date = "2026-04-23"

# After deploy, set these as secrets:
# wrangler secret put TELEGRAM_BOT_TOKEN
# wrangler secret put TELEGRAM_CHAT_IDS
# wrangler secret put SMARTCAPTCHA_SECRET_KEY
#
# TELEGRAM_CHAT_IDS supports one or several chat ids separated by comma:
# 123456789,987654321
